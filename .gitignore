# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — generated knowledge graph. Reproducible with `/graphify`, and
# .graphify_python stores an absolute path from whoever built it.
graphify-out/

# design reference material. Anything in /public is publicly served and lands
# in every clone; a 17 MB reference video is neither a site asset nor something
# we want on the CDN. Keep it locally, out of git.
/public/videos/
